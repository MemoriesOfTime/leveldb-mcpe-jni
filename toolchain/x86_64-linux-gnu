ifndef LDB_NATIVES_DEBUG
# release mode
export CFLAGS		:=	$(CFLAGS) -flto=$(NPROC) -fno-fat-lto-objects
export CXXFLAGS		:=	$(CXXFLAGS) -flto=$(NPROC) -fno-fat-lto-objects
export LDFLAGS		:=	$(LDFLAGS) -flto=$(NPROC) -fno-fat-lto-objects
else
# debug mode
export CFLAGS		:=	$(CFLAGS)
export CXXFLAGS		:=	$(CXXFLAGS)
export LDFLAGS		:=	$(LDFLAGS)
endif

X86_64_LINUX_GNU_CC		?=	$(shell command -v x86_64-linux-gnu-gcc 2>/dev/null || command -v x86_64-unknown-linux-gnu-gcc 2>/dev/null || echo x86_64-linux-gnu-gcc)
X86_64_LINUX_GNU_CXX	?=	$(shell command -v x86_64-linux-gnu-g++ 2>/dev/null || command -v x86_64-unknown-linux-gnu-g++ 2>/dev/null || echo x86_64-linux-gnu-g++)
X86_64_LINUX_GNU_AR		?=	$(shell command -v x86_64-linux-gnu-ar 2>/dev/null || command -v x86_64-unknown-linux-gnu-ar 2>/dev/null || echo x86_64-linux-gnu-ar)
X86_64_LINUX_GNU_RANLIB	?=	$(shell command -v x86_64-linux-gnu-ranlib 2>/dev/null || command -v x86_64-unknown-linux-gnu-ranlib 2>/dev/null || echo x86_64-linux-gnu-ranlib)
X86_64_LINUX_GNU_STRIP	?=	$(shell command -v x86_64-linux-gnu-strip 2>/dev/null || command -v x86_64-unknown-linux-gnu-strip 2>/dev/null || echo x86_64-linux-gnu-strip)

export CC		:= $(X86_64_LINUX_GNU_CC)
export CXX		:= $(X86_64_LINUX_GNU_CXX)
export LD		:= $(X86_64_LINUX_GNU_CXX)
export AR		:= $(X86_64_LINUX_GNU_AR)
export ARFLAGS	:= rcs
export RANLIB	:= $(X86_64_LINUX_GNU_RANLIB)
export STRIP	:= $(X86_64_LINUX_GNU_STRIP)
export CHOST	:= x86_64-linux-gnu
export ZLIB_CONFIGURE_FLAGS	:= --uname=Linux

export EXT	:=	so
