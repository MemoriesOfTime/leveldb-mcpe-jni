ifndef LDB_NATIVES_DEBUG
# release mode
export CFLAGS		:=	$(CFLAGS) -flto=$(NPROC) -fno-fat-lto-objects
export CXXFLAGS		:=	$(CXXFLAGS) -flto=$(NPROC) -fno-fat-lto-objects
export LDFLAGS		:=	$(LDFLAGS) -flto=$(NPROC) -fno-fat-lto-objects
else
# debug mode
export CFLAGS		:=	$(CFLAGS)
export CXXFLAGS		:=	$(CXXFLAGS)
export LDFLAGS		:=	$(LDFLAGS)
endif

AARCH64_LINUX_MUSL_CC		?=	$(shell command -v aarch64-linux-musl-gcc 2>/dev/null || command -v aarch64-unknown-linux-musl-gcc 2>/dev/null || command -v aarch64-alpine-linux-musl-gcc 2>/dev/null || echo aarch64-linux-musl-gcc)
AARCH64_LINUX_MUSL_CXX		?=	$(shell command -v aarch64-linux-musl-g++ 2>/dev/null || command -v aarch64-unknown-linux-musl-g++ 2>/dev/null || command -v aarch64-alpine-linux-musl-g++ 2>/dev/null || echo aarch64-linux-musl-g++)
AARCH64_LINUX_MUSL_AR		?=	$(shell command -v aarch64-linux-musl-ar 2>/dev/null || command -v aarch64-unknown-linux-musl-ar 2>/dev/null || command -v aarch64-alpine-linux-musl-ar 2>/dev/null || echo aarch64-linux-musl-ar)
AARCH64_LINUX_MUSL_RANLIB	?=	$(shell command -v aarch64-linux-musl-ranlib 2>/dev/null || command -v aarch64-unknown-linux-musl-ranlib 2>/dev/null || command -v aarch64-alpine-linux-musl-ranlib 2>/dev/null || echo aarch64-linux-musl-ranlib)
AARCH64_LINUX_MUSL_STRIP	?=	$(shell command -v aarch64-linux-musl-strip 2>/dev/null || command -v aarch64-unknown-linux-musl-strip 2>/dev/null || command -v aarch64-alpine-linux-musl-strip 2>/dev/null || echo aarch64-linux-musl-strip)

export CC		:= $(AARCH64_LINUX_MUSL_CC)
export CXX		:= $(AARCH64_LINUX_MUSL_CXX)
export LD		:= $(AARCH64_LINUX_MUSL_CXX)
export AR		:= $(AARCH64_LINUX_MUSL_AR)
export ARFLAGS	:= rcs
export RANLIB	:= $(AARCH64_LINUX_MUSL_RANLIB)
export STRIP	:= $(AARCH64_LINUX_MUSL_STRIP)
export CHOST	:= aarch64-linux-musl
export ZLIB_CONFIGURE_FLAGS	:= --uname=Linux

export EXT	:=	so
