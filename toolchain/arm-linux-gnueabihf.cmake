set(COMPILER_PREFIX "arm-linux-gnueabihf")
set(ALT_COMPILER_PREFIX "arm-unknown-linux-gnueabihf")
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR arm)

find_program(CMAKE_C_COMPILER NAMES ${COMPILER_PREFIX}-gcc ${ALT_COMPILER_PREFIX}-gcc)
find_program(CMAKE_CXX_COMPILER NAMES ${COMPILER_PREFIX}-g++ ${ALT_COMPILER_PREFIX}-g++)
find_program(CMAKE_AR NAMES ${COMPILER_PREFIX}-ar ${ALT_COMPILER_PREFIX}-ar)
find_program(CMAKE_RANLIB NAMES ${COMPILER_PREFIX}-ranlib ${ALT_COMPILER_PREFIX}-ranlib)
if(NOT CMAKE_C_COMPILER OR NOT CMAKE_CXX_COMPILER)
    message(FATAL_ERROR "Missing armhf Linux cross compiler. Install ${COMPILER_PREFIX}-gcc/g++ or ${ALT_COMPILER_PREFIX}-gcc/g++.")
endif()
if(NOT CMAKE_AR OR NOT CMAKE_RANLIB)
    message(FATAL_ERROR "Missing armhf Linux archive tools. Install ${COMPILER_PREFIX}-ar/ranlib or ${ALT_COMPILER_PREFIX}-ar/ranlib.")
endif()

SET(USER_ROOT_PATH)
SET(CMAKE_FIND_ROOT_PATH  /usr/${COMPILER_PREFIX} /usr/${ALT_COMPILER_PREFIX} ${USER_ROOT_PATH})

set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
